# Kept intentionally minimal on disk — env is operator/tooling territory.

# LLM inference endpoint (Ollama /v1). Override to run the model in-container:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
#
# LLM_MODEL=ornith-1.5:9b

# Local Ollama stack
# DOCKER_COMPOSE=docker-compose.local.yml   # compose file that mounts host Ollama
